FROM python:3.11-slim-bookworm AS base

# Ensure the directory for the UNIX socket exists
RUN mkdir -p /var/run/ospd \
    && chmod -R 755 /var/run/ospd

# Install system dependencies required by ospd-openvas + scanner integration
RUN apt-get update && apt-get install -y --no-install-recommends \
    git \
    gcc \
    python3-dev \
    libglib2.0-dev \
    libgnutls28-dev \
    libgcrypt20-dev \
    pkg-config \
    libpcap-dev \
    libssh-gcrypt-dev \
    libksba-dev \
    libjson-glib-dev \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment for OSPD + OSPD-OpenVAS
RUN python3 -m venv /opt/ospd-venv
ENV PATH="/opt/ospd-venv/bin:${PATH}"

# Clone and install OSPD first (required for ospd-openvas)
RUN git clone https://github.com/greenbone/ospd.git /opt/ospd \
    && pip install --no-cache-dir /opt/ospd

# Clone and install OSPD-OpenVAS
RUN git clone https://github.com/greenbone/ospd-openvas.git /opt/ospd-openvas \
    && pip install --no-cache-dir /opt/ospd-openvas

# Expose the UNIX socket path as a volume (optional but recommended)
VOLUME ["/var/run/ospd"]

# Default command to run ospd-openvas with the correct socket path
CMD ["ospd-openvas", \
     "--unix-socket=/var/run/ospd/ospd-openvas.sock", \
     "--log-level=INFO"]
